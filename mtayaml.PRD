_schema-version: 3.3.0
ID: asientos-ajustes
description: A simple CAP project.
version: 1.0.0
modules:
- name: asientos-ajustes-srv
  type: nodejs
  path: gen/srv
  requires:
  - name: asientos-ajustes-auth
  - name: asientos-ajustes-destination
  - name: dest_dms_dev
  - name: asientos-ajustes-connectivity-service
  - name: ups-database-external
  provides:
  - name: srv-api
    properties:
      CDS_BODY_LIMIT: 10mb
      srv-url: ${default-url}
  parameters:
    buildpack: nodejs_buildpack
    instances: 1
  build-parameters:
    builder: npm-ci
- name: asientos-ajustes-app-deployer
  type: com.sap.application.content
  path: .
  requires:
  - name: asientos-ajustes-auth
  - name: srv-api
  - name: asientos-ajustes-html5-repo-host
    parameters:
      config:
        HTML5Runtime_enabled: true
      content-target: true
  parameters:
    config:
      HTML5Runtime_enabled: true
      init_data:
        instance:
          destinations:
          - Authentication: NoAuthentication
            HTML5.DynamicDestination: true
            HTML5.ForwardAuthToken: true
            Name: srv-api
            ProxyType: Internet
            Type: HTTP
            URL: ~{srv-api/srv-url}
          - Authentication: NoAuthentication
            Name: ui5
            ProxyType: Internet
            Type: HTTP
            URL: https://ui5.sap.com
          existing_destinations_policy: update
  build-parameters:
    build-result: resources/
    requires:
    - artifacts:
      - comcarrefourmaestroconfigaprobadores.zip
      name: comcarrefourmaestroconfigaprobadores
      target-path: resources/
    - artifacts:
      - comcarrefourmaestroconfigsolicitantes.zip
      name: comcarrefourmaestroconfigsolicitantes
      target-path: resources/
    - artifacts:
      - comcarrefourmaestrocuentas.zip
      name: comcarrefourmaestrocuentas
      target-path: resources/
    - artifacts:
      - comcarrefourmaestroumbralescuentas.zip
      name: comcarrefourmaestroumbralescuentas
      target-path: resources/
    - artifacts:
      - comcarrefourconsultaestadosolicitudes.zip
      name: comcarrefourconsultaestadosolicitudes
      target-path: resources/
    - artifacts:
      - comcarrefourmaestroempleados.zip
      name: comcarrefourmaestroempleados
      target-path: resources/
    - artifacts:
      - comcarrefourmaestrosectores.zip
      name: comcarrefourmaestrosectores
      target-path: resources/
- name: asientos-ajustes-destinations
  type: com.sap.application.content
  requires:
  - name: asientos-ajustes-auth
    parameters:
      service-key:
        name: asientos-ajustes-auth-key
  - name: asientos-ajustes-html5-repo-host
    parameters:
      service-key:
        name: asientos-ajustes-html5-repo-host-key
  - name: srv-api
  - name: asientos-ajustes-destination
    parameters:
      content-target: true
  parameters:
    content:
      instance:
        destinations:
        - Name: asientos-ajustes-html5-repository
          ServiceInstanceName: asientos-ajustes-html5-repo-host
          ServiceKeyName: asientos-ajustes-html5-repo-host-key
          sap.cloud.service: asientosajustes.service
        - Authentication: OAuth2UserTokenExchange
          Name: asientos-ajustes-auth
          ServiceInstanceName: asientos-ajustes-auth
          ServiceKeyName: asientos-ajustes-auth-key
          sap.cloud.service: asientosajustes.service
        existing_destinations_policy: update
  build-parameters:
    no-source: true
- name: comcarrefourmaestroconfigaprobadores
  type: html5
  path: app/maestro-configaprobadores
  build-parameters:
    build-result: dist
    builder: custom
    commands:
    - npm install
    - npm run build:cf
    supported-platforms: []
- name: comcarrefourmaestroconfigsolicitantes
  type: html5
  path: app/maestro-configsolicitantes
  build-parameters:
    build-result: dist
    builder: custom
    commands:
    - npm install
    - npm run build:cf
    supported-platforms: []
- name: comcarrefourmaestrocuentas
  type: html5
  path: app/maestro-cuentas
  build-parameters:
    build-result: dist
    builder: custom
    commands:
    - npm install
    - npm run build:cf
    supported-platforms: []
- name: comcarrefourmaestroumbralescuentas
  type: html5
  path: app/maestro-umbralescuentas
  build-parameters:
    build-result: dist
    builder: custom
    commands:
    - npm install
    - npm run build:cf
    supported-platforms: []
- name: comcarrefourconsultaestadosolicitudes
  type: html5
  path: app/consulta-estado-solicitudes
  build-parameters:
    build-result: dist
    builder: custom
    commands:
    - npm install
    - npm run build:cf
    supported-platforms: []
- name: comcarrefourmaestroempleados
  type: html5
  path: app/maestro-empleados
  build-parameters:
    build-result: dist
    builder: custom
    commands:
    - npm install
    - npm run build:cf
    supported-platforms: []
- name: comcarrefourmaestrosectores
  type: html5
  path: app/maestro-sectores
  build-parameters:
    build-result: dist
    builder: custom
    commands:
    - npm install
    - npm run build:cf
    supported-platforms: []
resources:
- name: ups-database-external
  type: org.cloudfoundry.existing-service
  parameters:
    service: user-provided
    service-name: ups-database-external
- name: asientos-ajustes-auth
  type: org.cloudfoundry.managed-service
  parameters:
    config:
      role-collections:
      - description: generated
        name: Aprobador (asientos-ajustes-${space})
        role-template-references:
        - $XSAPPNAME.Aprobador
      - description: generated
        name: Solicitante (asientos-ajustes-${space})
        role-template-references:
        - $XSAPPNAME.Solicitante
      - description: generated
        name: Admin_Datos_Maestros (asientos-ajustes-${space})
        role-template-references:
        - $XSAPPNAME.Admin_Datos_Maestros
      tenant-mode: dedicated
      xsappname: asientos-ajustes-${space}
    path: ./xs-security.json
    service: xsuaa
    service-plan: application
- name: asientos-ajustes-destination
  type: org.cloudfoundry.managed-service
  parameters:
    config:
      HTML5Runtime_enabled: true
      init_data:
        instance:
          destinations:
          - Authentication: NoAuthentication
            HTML5.DynamicDestination: true
            HTML5.ForwardAuthToken: true
            Name: srv-api
            ProxyType: Internet
            Type: HTTP
            URL: ~{srv-api/srv-url}
          - Authentication: NoAuthentication
            Name: ui5
            ProxyType: Internet
            Type: HTTP
            URL: https://ui5.sap.com
          existing_destinations_policy: update
    service: destination
    service-plan: lite
  requires:
  - name: srv-api
    group: destinations
    properties:
      forwardAuthToken: true
      name: srv-api
      url: ~{srv-url}
- name: asientos-ajustes-html5-repo-host
  type: org.cloudfoundry.managed-service
  parameters:
    service: html5-apps-repo
    service-plan: app-host
- name: asientos-ajustes-html5-runtime
  type: org.cloudfoundry.managed-service
  parameters:
    service: html5-apps-repo
    service-plan: app-runtime
- name: dest_dms_dev
  type: org.cloudfoundry.managed-service
  parameters:
    config:
      Authentication: OAuth2ClientCredentials
      HTML5Runtime_enabled: false
      Name: dest_dms_dev
      ProxyType: Internet
      URL: https://api-sdm-di.cfapps.us30.hana.ondemand.com
      init_data:
        instance:
          destinations:
          - Authentication: NoAuthentication
            HTML5.DynamicDestination: true
            HTML5.ForwardAuthToken: true
            Name: srv-api
            ProxyType: Internet
            Type: HTTP
            URL: ~{srv-api/srv-url}
          - Authentication: NoAuthentication
            Name: ui5
            ProxyType: Internet
            Type: HTTP
            URL: https://ui5.sap.com
          existing_destinations_policy: update
    service: destination
    service-plan: lite
  requires:
  - name: srv-api
    group: destinations
    properties:
      forwardAuthToken: true
      name: srv-api
      url: ~{srv-url}
- name: asientos-ajustes-connectivity-service
  type: org.cloudfoundry.managed-service
  parameters:
    service: connectivity
    service-plan: lite
parameters:
  deploy_mode: html5-repo
  enable-parallel-deployments: true
build-parameters:
  before-all:
  - builder: custom
    commands:
    - npm ci
    - npx cds build --production
