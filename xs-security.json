{
  "xsappname": "asientos-ajustes",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.Aprobador",
      "description": "Aprobador"
    },
    {
      "name": "$XSAPPNAME.Solicitante",
      "description": "Solicitante"
    },
    {
      "name": "$XSAPPNAME.Admin_Datos_Maestros",
      "description": "Admin_Datos_Maestros"
    },
    {
      "name": "$XSAPPNAME.Callback",
      "description": "Allow token exchange",
      "grant-as-authority-to-apps": []
    }
  ],
  "attributes": [],
  "role-templates": [
    {
      "name": "Admin_Datos_Maestros",
      "description": "generated",
