        "$XSAPPNAME.Admin_Datos_Maestros"
      ],
      "attribute-references": []
    },
    {
      "name": "Aprobador",
      "description": "generated",
      "scope-references": [
        "$XSAPPNAME.Aprobador"
      ],
      "attribute-references": []
    },
    {
      "name": "Solicitante",
      "description": "generated",
      "scope-references": [
        "$XSAPPNAME.Solicitante"
      ],
      "attribute-references": []
    }
  ],
  "oauth2-configuration": {
    "redirect-uris": [
      "https://oauth.pstmn.io/v1/browser-callback"
    ],
    "token-validity": 3600
  }
