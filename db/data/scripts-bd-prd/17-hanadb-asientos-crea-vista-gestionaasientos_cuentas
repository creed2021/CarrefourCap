    CREATEDAT LONGDATE,
    CREATEDBY NVARCHAR(255),
    MODIFIEDAT LONGDATE,
    MODIFIEDBY NVARCHAR(255),
    NUMERO NVARCHAR(20),
    NOMBRE NVARCHAR(100),
    TIPO_ID NVARCHAR(36),
    ISACTIVEENTITY BOOLEAN,
